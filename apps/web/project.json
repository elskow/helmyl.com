{
	"name": "web",
	"$schema": "../../node_modules/nx/schemas/project-schema.json",
	"sourceRoot": "apps/web/src",
	"projectType": "application",
	"targets": {
		"build": {
			"executor": "nx:run-commands",
			"outputs": ["{projectRoot}/dist"],
			"options": {
				"command": "pnpm exec astro build",
				"cwd": "apps/web"
			}
		},
		"dev": {
			"executor": "nx:run-commands",
			"options": {
				"command": "pnpm exec astro dev",
				"cwd": "apps/web"
			}
		},
		"preview": {
			"executor": "nx:run-commands",
			"dependsOn": ["build"],
			"options": {
				"command": "pnpm exec serve dist -l 4173",
				"cwd": "apps/web"
			}
		},
		"clean": {
			"executor": "nx:run-commands",
			"options": {
				"command": "rm -rf dist .astro",
				"cwd": "apps/web"
			}
		},
		"check": {
			"executor": "nx:run-commands",
			"options": {
				"command": "pnpm exec astro sync && pnpm exec astro check",
				"cwd": "apps/web"
			}
		},
		"lint": {
			"executor": "nx:run-commands",
			"options": {
				"command": "prettier --check \"src/**/*.ts\"",
				"cwd": "apps/web"
			}
		},
		"format": {
			"executor": "nx:run-commands",
			"options": {
				"command": "prettier --write src",
				"cwd": "apps/web"
			}
		}
	},
	"tags": ["type:app"]
}
