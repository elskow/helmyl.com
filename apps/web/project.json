{
	"name": "web",
	"$schema": "../../node_modules/nx/schemas/project-schema.json",
	"sourceRoot": "apps/web/src",
	"projectType": "application",
	"targets": {
		"build": {
			"executor": "nx:run-commands",
			"dependsOn": ["^build"],
			"outputs": ["{projectRoot}/dist", "{workspaceRoot}/apps/web/src/lib/generated/labs-metadata.json"],
			"options": {
				"command": "./scripts/build-web.sh",
				"cwd": "."
			}
		},
		"dev": {
			"executor": "nx:run-commands",
			"options": {
				"commands": [
					"pnpm exec tsx apps/scripts/generate-labs-metadata.ts --out apps/web/src/lib/generated/labs-metadata.json",
					"cd apps/web && pnpm exec astro dev"
				],
				"cwd": ".",
				"parallel": false
			}
		},
		"preview": {
			"executor": "nx:run-commands",
			"dependsOn": ["build"],
			"options": {
				"command": "npx serve dist -l 4173",
				"cwd": "apps/web"
			}
		},
		"clean": {
			"executor": "nx:run-commands",
			"options": {
				"command": "rm -rf dist .astro",
				"cwd": "apps/web"
			}
		},
		"check": {
			"executor": "nx:run-commands",
			"options": {
				"command": "npx astro sync && npx astro check",
				"cwd": "apps/web"
			}
		},
		"lint": {
			"executor": "nx:run-commands",
			"options": {
				"command": "prettier --check \"src/**/*.ts\"",
				"cwd": "apps/web"
			}
		},
		"format": {
			"executor": "nx:run-commands",
			"options": {
				"command": "prettier --write src",
				"cwd": "apps/web"
			}
		}
	},
	"tags": ["type:app"],
	"implicitDependencies": ["tag:type:lab"]
}
