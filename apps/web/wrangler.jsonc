{
	"name": "helmyl-com",
	"compatibility_date": "2026-11-22",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	"assets": {
		"binding": "ASSETS",
		"directory": "./dist"
	},
	"kv_namespaces": [
		{
			"binding": "SESSION",
			"id": "cd346f204505437f9369b53c7e66b196"
		}
	],
	"observability": {
		"enabled": true
	}
}
