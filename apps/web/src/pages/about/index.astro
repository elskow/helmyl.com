---
import Base from '@/layouts/Base.astro';
import Footer from '@/components/Footer.astro';
import Icon from '@/components/Icon.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import { experience, skills, honors, socials, bio } from '@/data/about';

const pageTitle = 'About - Helmy Luqmanulhakim';
const pageDescription =
	'Software engineer focused on reliable web and data systems. Cloud-native design, performance, and clear architecture.';

const breadcrumbs = [
	{ label: 'Home', url: '/' },
	{ label: 'About', url: '/about' }
];

const jsonLd = [
	{
		'@type': 'ProfilePage',
		'@id': 'https://helmyl.com/about#profilepage',
		url: 'https://helmyl.com/about',
		mainEntity: { '@id': 'https://helmyl.com/#person' },
		dateModified: new Date().toISOString().split('T')[0]
	}
];
---

<Base
	title={pageTitle}
	description={pageDescription}
	path="/about"
	ogImage="/og/about.png"
	ogType="profile"
	jsonLd={jsonLd}
>
	<main id="main-content"
		class="max-w-screen-xl mx-auto px-4 sm:px-6 py-10 md:py-24 min-h-screen text-neutral-900 font-sans"
	>
		<div class="grid grid-cols-1 md:grid-cols-12 gap-8 md:gap-12 lg:gap-24">
			<div class="md:col-span-7 lg:col-span-8">
				<header class="mb-12 md:mb-16">
					<Breadcrumbs items={breadcrumbs} />
					<h1
						class="text-3xl sm:text-4xl font-medium tracking-tight leading-[1.15] text-neutral-950 mb-4"
					>
						Who am i?
					</h1>
					<p class="text-lg text-neutral-500 leading-relaxed font-light">
						Engineer. Builder. Problem Solver.
					</p>
				</header>

				<article class="about-content">
					<p>{bio}</p>

					<h2 class="about-heading">Skills &amp; Expertise</h2>
					<ul>
						{
							Object.entries(skills).map(([category, items]) => (
								<li>
									<strong>{category}</strong>
									<span>{items.join(', ')}.</span>
								</li>
							))
						}
					</ul>

					<h2 class="about-heading">Experience</h2>
					<table>
						<caption class="sr-only">Work experience history: dates, roles, and companies</caption>
						<tbody>
							{
								experience.map((job) => (
									<tr>
										<td>{job.date}</td>
										<td>{job.role}</td>
										<td>
											<a href={job.url} target="_blank" rel="noopener noreferrer">{job.company}</a>
										</td>
									</tr>
								))
							}
						</tbody>
					</table>

					<h2 class="about-heading">Honors &amp; Certifications</h2>
					<ul>
						{
							honors.map((honor) => (
								<li>
									<a href={honor.url} target="_blank" rel="noopener noreferrer">{honor.label}</a>
								</li>
							))
						}
					</ul>

					<h2 class="about-heading">Online Presence</h2>
					<p class="social-links">
						{
							socials.map((social, i) => (
								<>
									<a
										href={social.url}
										target={social.url.startsWith('mailto') ? undefined : '_blank'}
									>
										{social.label}
									</a>
									{i < socials.length - 1 ? ' /' : ''}
								</>
							))
						}
					</p>
				</article>
			</div>

			<aside
				class="md:col-span-5 lg:col-span-4 md:pl-6 lg:pl-12 xl:pl-24 space-y-8 md:space-y-12 pt-8 md:pt-0 border-t border-neutral-100 md:border-t-0 mt-12 md:mt-0 min-w-0"
			>
				<div class="md:sticky md:top-24 space-y-8 md:space-y-12">
					<div aria-hidden="true" class="hidden md:block text-neutral-300">
						<Icon name="user" class="w-6 h-6" stroke-width={1.5} />
					</div>

					<div>
						<p class="text-xs text-neutral-400 mb-6 uppercase tracking-wide select-none">
							Connect
						</p>
						<nav aria-label="Social profiles">
							<ul class="flex flex-wrap gap-x-6 gap-y-4 md:block md:space-y-4 text-sm list-none p-0">
								{
									[
										{ label: 'GitHub', url: 'https://github.com/elskow' },
										{ label: 'LinkedIn', url: 'https://linkedin.com/in/helmyl' },
										{ label: 'Twitter', url: 'https://twitter.com/helmy_lh' },
										{ label: 'Email', url: 'mailto:helmyl.work@gmail.com' }
									].map(({ label, url }) => (
										<li>
											<a
												href={url}
												target={url.startsWith('mailto') ? undefined : '_blank'}
												rel={url.startsWith('mailto') ? undefined : 'noopener noreferrer'}
												class="flex items-center gap-2 md:justify-between group"
											>
												<span class="text-neutral-900 group-hover:underline decoration-neutral-300 underline-offset-4">
													{label}
												</span>
												<span aria-hidden="true">
													<Icon
														name={url.startsWith('mailto') ? 'at-sign' : 'arrow-up-right'}
														class="w-3.5 h-3.5 text-neutral-400"
													/>
												</span>
											</a>
										</li>
									))
								}
							</ul>
						</nav>
					</div>
				</div>
			</aside>
		</div>
	</main>
	<Footer />
</Base>

<style>
	.about-content {
		color: #525252;
	}

	.about-content :global(p) {
		margin-bottom: 1.5rem;
		line-height: 1.8;
		font-weight: 400;
		font-size: 1rem;
	}

	.about-content :global(a) {
		color: #171717;
		font-weight: 500;
		text-decoration: underline;
		text-decoration-color: #d4d4d4;
		text-underline-offset: 3px;
		transition: all 0.2s;
	}
	.about-content :global(a:hover) {
		text-decoration-color: #171717;
		background-color: #f5f5f5;
	}

	.about-content :global(h2) {
		color: #171717;
		margin-top: 4rem;
		margin-bottom: 1.5rem;
		font-size: 0.875rem;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		border-bottom: 1px solid #f5f5f5;
		padding-bottom: 0.75rem;
	}

	.about-content :global(ul) {
		margin-bottom: 3rem;
		padding-left: 0;
		list-style-type: none;
	}
	.about-content :global(li) {
		position: relative;
		padding-left: 1.25rem;
		margin-bottom: 0.75rem;
		line-height: 1.6;
		font-size: 0.9375rem;
		color: #525252;
	}

	.about-content :global(li)::before {
		content: '';
		position: absolute;
		left: 0;
		top: 0.6rem;
		width: 4px;
		height: 4px;
		background-color: #a3a3a3;
		border-radius: 50%;
	}

	.about-content :global(li:has(strong)) {
		display: grid;
		grid-template-columns: 160px 1fr;
		gap: 1rem;
		padding-left: 0;
		padding-bottom: 0.75rem;
		border-bottom: 1px dashed #f5f5f5;
		align-items: baseline;
	}

	.about-content :global(li:has(strong):last-child) {
		border-bottom: none;
	}

	.about-content :global(li:has(strong)::before) {
		content: none;
	}

	.about-content :global(li strong) {
		color: #171717;
		font-weight: 500;
		font-size: 0.875rem;
	}

	.about-content :global(strong) {
		color: #171717;
		font-weight: 500;
	}

	.about-content :global(table) {
		width: 100%;
		border-collapse: collapse;
		margin-top: 1rem;
		margin-bottom: 3rem;
		font-size: 0.875rem;
		text-align: left;
	}

	.about-content :global(tr) {
		border-bottom: 1px dashed #f5f5f5;
	}

	.about-content :global(tr:last-child) {
		border-bottom: none;
	}

	.about-content :global(td) {
		padding: 1rem 1rem 1rem 0;
		color: #525252;
		vertical-align: top;
	}

	.about-content :global(td:nth-child(1)) {
		width: 25%;
		color: #a3a3a3;
		font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
		font-size: 0.75rem;
		line-height: 1.5;
	}

	.about-content :global(td:nth-child(2)) {
		width: 35%;
		font-weight: 500;
		color: #171717;
	}

	.about-content :global(td:nth-child(3)) {
		width: 40%;
	}

	@media (max-width: 640px) {
		.about-content :global(tr) {
			display: flex;
			flex-direction: column;
			border-bottom: 1px solid #f5f5f5;
			padding-bottom: 1.5rem;
			margin-bottom: 1.5rem;
		}

		.about-content :global(td) {
			display: block;
			width: 100% !important;
			padding: 0.25rem 0;
			border: none;
		}

		.about-content :global(td:nth-child(1)) {
			order: -1;
			margin-bottom: 0.25rem;
		}

		.about-content :global(td:nth-child(2)) {
			font-size: 1rem;
			color: #171717;
			font-weight: 600;
		}

		.about-content :global(li:has(strong)) {
			display: flex;
			flex-direction: column;
			gap: 0.25rem;
			padding-bottom: 1rem;
		}

		.about-content :global(li:has(strong) strong) {
			color: #a3a3a3;
			text-transform: uppercase;
			font-size: 0.75rem;
			letter-spacing: 0.05em;
		}
	}
</style>
