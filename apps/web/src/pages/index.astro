---
import Base from '@/layouts/Base.astro';
import HeroHalftone from '@/components/HeroHalftone.astro';
import SiteFooter from '@/components/SiteFooter.astro';
import Icon from '@/components/Icon.astro';
import BentoGrid from '@/components/BentoGrid.astro';
import { sortedProjects } from '@/data/projects';
import ExperienceTimeline from '@/components/ExperienceTimeline.astro';
import GitHubContributions from '@/components/GitHubContributions.astro';

const projects = sortedProjects;

export const experience = [
	{
		role: 'Scala Software Engineer',
		company: 'Ziverge (Zio)',
		logo: '/images/companies/ziverge.png',
		start: '2025-12',
		end: '2026-03',
		date: 'Dec 2025 - Mar 2026',
		location: 'New York, US · Remote, Freelance',
		description:
			'Maintained zio-blocks, a Scala library for compositional, type-safe data schemas in the ZIO ecosystem.',
		link: 'https://www.ziverge.com/'
	},
	{
		role: 'Application Developer',
		company: 'Bank Central Asia',
		logo: '/images/companies/bca.png',
		start: '2025-03',
		end: '2025-12',
		date: 'Mar 2025 - Dec 2025',
		location: 'Central Jakarta, ID · On-site',
		description:
			'Developed enterprise banking applications using Java EE and EJB for B2B financial systems.',
		link: 'https://www.bca.co.id/'
	},
	{
		role: 'DevOps Engineer',
		company: 'Prequel',
		logo: '/images/companies/prequel.png',
		start: '2025-06',
		end: '2025-10',
		date: 'Jun 2025 - Oct 2025',
		location: 'New York, US · Remote',
		description:
			'Worked on Cloud Native service degradation rules (CRE) for reliability problem detection.',
		link: 'https://www.prequel.co/'
	},
	{
		role: 'Open Source Developer',
		company: 'GitLab',
		logo: '/images/companies/gitlab.svg',
		start: '2025-04',
		end: '2025-06',
		date: 'Apr 2025 - Jun 2025',
		location: 'San Francisco, US · Remote',
		description:
			'Contributed to GLQL, ported the GraphQL language parser from JavaScript to Rust.',
		link: 'https://gitlab.com/'
	},
	{
		role: 'Machine Learning Cohort',
		company: 'Bangkit Academy',
		logo: '/images/companies/bangkit.png',
		start: '2024-09',
		end: '2025-01',
		date: 'Sep 2024 - Jan 2025',
		location: 'Jakarta, ID · Remote',
		description:
			'Google-backed program focused on machine learning, TensorFlow, and cloud deployment.',
		link: 'https://grow.google/intl/id_id/bangkit/'
	}
];

const pageTitle = 'Helmy Luqmanulhakim - Software Engineer';
const pageDescription =
	'Software engineer specializing in web development, data engineering, and building scalable solutions.';
---

<Base title={pageTitle} description={pageDescription} path="/" ogImage="/og/home.png">
	<div class="relative">
		<HeroHalftone />
	</div>
	<main
		id="main-content"
		class="relative max-w-3xl mx-auto px-4 sm:px-6 pt-0 pb-12 md:pb-24 min-h-screen text-neutral-900 font-sans"
	>
		<div class="relative space-y-24">
			<section class="space-y-8 pt-40 md:pt-64">
				<div class="w-12 h-12 bg-neutral-100 rounded-sm overflow-hidden border border-neutral-200">
					<img
						src="/images/avatar.jpg"
						alt="Helmy Luqmanulhakim"
						width="48"
						height="48"
						fetchpriority="high"
						decoding="async"
						class="w-full h-full object-cover grayscale hover:grayscale-0 transition-all duration-500 ease-out"
					/>
				</div>

				<div class="space-y-1">
					<h1 class="text-xl sm:text-2xl font-medium tracking-tight text-neutral-950">
						Helmy Luqmanulhakim
					</h1>
					<p class="text-base sm:text-lg text-neutral-500">
						Software design &amp; engineering
					</p>
					<p class="text-sm text-neutral-400">Surabaya, ID</p>
				</div>

				<div class="space-y-4 max-w-lg text-sm sm:text-base leading-relaxed text-neutral-600">
					<p>
						I build high-performance web systems and data infrastructure. Previously
						writing{' '}
						<Icon
							name="scala"
							class="w-4 h-4 inline-block -mt-0.5 text-neutral-900 align-middle"
						/>{' '}
						Scala at{' '}
						<a
							href="https://www.ziverge.com"
							target="_blank"
							class="text-neutral-900 border-b border-neutral-200 hover:border-neutral-900 transition-colors"
						>
							Ziverge
						</a>{' '}
						and{' '}
						<Icon
							name="java"
							class="w-4 h-4 inline-block -mt-0.5 text-neutral-900 align-middle"
						/>{' '}
						Java at{' '}
						<a
							href="https://www.bca.co.id"
							target="_blank"
							class="text-neutral-900 border-b border-neutral-200 hover:border-neutral-900 transition-colors"
						>
							{' '}
							Bank Central Asia.
						</a>
					</p>
					<p>Focused on scalability, clean architecture, and developer experience.</p>
				</div>

				<div class="flex flex-wrap items-center gap-3 sm:gap-4 pt-2">
					<a
						href="https://linkedin.com/in/helmyl"
						target="_blank"
						class="text-xs font-medium bg-neutral-100 hover:bg-neutral-200 active:bg-neutral-200 text-neutral-900 px-4 py-2.5 sm:px-3 sm:py-2 rounded-sm transition-colors flex items-center gap-1 min-h-[44px] sm:min-h-0"
					>
						LinkedIn <Icon name="arrow-up-right" class="w-3 h-3 text-neutral-500" />
					</a>

					<a
						href="mailto:helmyl.work@gmail.com"
						class="text-xs font-medium border border-neutral-200 hover:border-neutral-900 active:border-neutral-900 text-neutral-600 hover:text-neutral-900 px-4 py-2.5 sm:px-3 sm:py-2 rounded-sm transition-colors flex items-center gap-1 min-h-[44px] sm:min-h-0"
					>
						Email <Icon name="at-sign" class="w-3 h-3 text-neutral-400" />
					</a>
				</div>
			</section>

			<section aria-labelledby="section-activity">
				<h2
					id="section-activity"
					class="text-neutral-400 text-xs sm:text-sm uppercase tracking-wider mb-6 select-none"
				>
					Activity
				</h2>
				<GitHubContributions server:defer>
					<div slot="fallback" aria-hidden="true">
						<div class="flex items-baseline justify-between mb-3">
							<div class="flex items-center gap-2">
								<div class="h-3 w-8 rounded skeleton"></div>
								<div class="h-2.5 w-44 rounded skeleton"></div>
							</div>
							<div class="h-2.5 w-16 rounded skeleton"></div>
						</div>
						<div class="flex gap-3 overflow-x-auto pb-3 pt-1 -mb-1 thin-scrollbar">
							<div class="hidden sm:flex flex-col gap-1 pt-[18px] shrink-0">
								<div class="h-1.5 w-6 rounded skeleton"></div>
								<div class="h-1.5 w-6 rounded skeleton mt-[19px]"></div>
								<div class="h-1.5 w-6 rounded skeleton mt-[19px]"></div>
							</div>
							<div class="w-full grid grid-rows-7 gap-[3px] min-w-[506px]">
								{Array.from({ length: 7 }).map(() => (
									<div class="flex gap-[3px]">
										{Array.from({ length: 53 }).map(() => (
											<div class="h-[11px] flex-1 rounded-[2.5px] skeleton opacity-60"></div>
										))}
									</div>
								))}
							</div>
						</div>
					</div>
				</GitHubContributions>
			</section>

			<section aria-labelledby="section-experience">
				<h2
					id="section-experience"
					class="text-neutral-400 text-xs sm:text-sm uppercase tracking-wider mb-6 select-none"
				>
					Experience
				</h2>
				<ExperienceTimeline jobs={experience} />
			</section>

			<section class="relative max-w-[76rem] mx-auto mt-24" aria-label="Projects and stack">
				<BentoGrid projects={projects} />
			</section>
		</div>
	</main>
	<SiteFooter />
</Base>

<style>
	.link-draw {
		background-image: linear-gradient(currentColor, currentColor);
		background-size: 0% 1px;
		background-repeat: no-repeat;
		background-position: 0 100%;
		transition: background-size 0.3s ease-out;
	}
	.group:hover .link-draw,
	.link-draw:hover {
		background-size: 100% 1px;
	}
</style>
