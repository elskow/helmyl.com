---
import Base from '@/layouts/Base.astro';
import ProjectCard from '@/components/ProjectCard.astro';
import HeroHalftone from '@/components/HeroHalftone.astro';
import Footer from '@/components/Footer.astro';
import Icon from '@/components/Icon.astro';
import { technologies } from '@/data/technologies';
import { sortedProjects } from '@/data/projects';

const projects = sortedProjects;

const experience = [
	{
		role: 'Scala Software Engineer',
		company: 'Ziverge (Zio)',
		date: 'Dec 2025 — Mar 2026',
		location: 'New York, US · Remote, Freelance',
		description:
			'Maintained zio-blocks, a Scala library for compositional, type-safe data schemas in the ZIO ecosystem.',
		link: 'https://www.ziverge.com/'
	},
	{
		role: 'Application Developer',
		company: 'Bank Central Asia',
		date: 'Mar 2025 — Dec 2025',
		location: 'Central Jakarta, ID · On-site',
		description:
			'Developed enterprise banking applications using Java EE and EJB for B2B financial systems.',
		link: 'https://www.bca.co.id/'
	},
	{
		role: 'DevOps Engineer',
		company: 'Prequel',
		date: 'Jun 2025 — Oct 2025',
		location: 'New York, US · Remote',
		description:
			'Worked on Cloud Native service degradation rules (CRE) for reliability problem detection.',
		link: 'https://www.prequel.co/'
	},
	{
		role: 'Open Source Developer',
		company: 'GitLab',
		date: 'Apr 2025 — Jun 2025',
		location: 'San Francisco, US · Remote',
		description:
			'Contributed to GLQL, ported the GraphQL language parser from JavaScript to Rust.',
		link: 'https://gitlab.com/'
	},
	{
		role: 'Machine Learning Cohort',
		company: 'Bangkit Academy',
		date: 'Sep 2024 — Jan 2025',
		location: 'Jakarta, ID · Remote',
		description:
			'Google-backed program focused on machine learning, TensorFlow, and cloud deployment.',
		link: 'https://grow.google/intl/id_id/bangkit/'
	}
];

const pageTitle = 'Helmy Luqmanulhakim - Software Engineer';
const pageDescription =
	'Software engineer specializing in web development, data engineering, and building scalable solutions.';
---

<Base title={pageTitle} description={pageDescription} path="/" ogImage="/og/home.png">
	<div class="relative">
		<HeroHalftone />
	</div>
	<main
		id="main-content"
		class="relative max-w-3xl mx-auto px-4 sm:px-6 pt-0 pb-12 md:pb-24 min-h-screen text-neutral-900 font-sans"
	>
		<div class="relative space-y-24">
			<section class="space-y-8 pt-40 md:pt-64">
				<div class="w-12 h-12 bg-neutral-100 rounded-sm overflow-hidden border border-neutral-200">
						<img
							src="/images/avatar.jpg"
							alt="Helmy Luqmanulhakim"
							width="48"
							height="48"
							fetchpriority="high"
							decoding="async"
							class="w-full h-full object-cover grayscale hover:grayscale-0 transition-all duration-500 ease-out"
						/>
					</div>

					<div class="space-y-1">
						<h1 class="text-xl font-medium tracking-tight text-neutral-950">
							Helmy Luqmanulhakim
						</h1>
						<p class="text-base text-neutral-500">Software design &amp; engineering</p>
						<p class="text-sm text-neutral-400">South Jakarta, ID</p>
					</div>

					<div class="space-y-4 max-w-lg text-base leading-relaxed text-neutral-600">
						<p>
							I build high-performance web systems and data infrastructure. Previously
							writing Scala at{' '}
							<a
								href="https://www.ziverge.com"
								target="_blank"
								class="text-neutral-900 border-b border-neutral-200 hover:border-neutral-900 transition-colors"
							>
								Ziverge
							</a>
							{' '}and Java at{' '}
							<a
								href="https://www.bca.co.id"
								target="_blank"
								class="text-neutral-900 border-b border-neutral-200 hover:border-neutral-900 transition-colors"
							>
								{' '}
								Bank Central Asia
							</a>
							.
						</p>
						<p>Focused on scalability, clean architecture, and developer experience.</p>
					</div>

					<div class="flex flex-wrap items-center gap-4 pt-2">
						<a
							href="https://linkedin.com/in/helmyl"
							target="_blank"
							class="text-xs font-medium bg-neutral-100 hover:bg-neutral-200 text-neutral-900 px-3 py-2 rounded-sm transition-colors flex items-center gap-1"
						>
							LinkedIn <Icon name="arrow-up-right" class="w-3 h-3 text-neutral-500" />
						</a>

						<a
							href="mailto:helmyl.work@gmail.com"
							class="text-xs font-medium border border-neutral-200 hover:border-neutral-900 text-neutral-600 hover:text-neutral-900 px-3 py-2 rounded-sm transition-colors flex items-center gap-1"
						>
							Email <Icon name="at-sign" class="w-3 h-3 text-neutral-400" />
						</a>
					</div>
				</section>

				<section aria-labelledby="section-experience">
					<h2
						id="section-experience"
						class="text-neutral-400 text-xs uppercase tracking-wider mb-8 select-none"
					>
						Experience
					</h2>

					<div class="space-y-8">
						{experience.map((job, i) => (
							<div class="group relative pl-0 md:pl-8">
								<span
									aria-hidden="true"
									class="absolute left-0 top-1 text-neutral-300 text-xs hidden md:block font-mono select-none"
								>
									{String(i + 1).padStart(2, '0')}
								</span>
								<div class="space-y-1.5">
									<div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-1">
										<h3 class="text-base font-medium text-neutral-900">
											{job.role}
											<span class="text-neutral-400 font-normal mx-1 text-sm">
												at
											</span>
											<a
												href={job.link}
												target="_blank"
												class="hover:text-black hover:underline decoration-neutral-200 underline-offset-4 transition-all"
											>
												{job.company}
											</a>
										</h3>
										<span class="text-xs text-neutral-400 font-mono shrink-0 pt-1 sm:pt-0">
											{job.date}
										</span>
									</div>
									<p class="text-xs text-neutral-400">{job.location}</p>
									<p class="text-sm text-neutral-500 leading-relaxed">
										{job.description}
									</p>
								</div>
							</div>
						))}
					</div>
				</section>

				<section aria-labelledby="section-work">
					<h2
						id="section-work"
						class="text-neutral-400 text-xs uppercase tracking-wider mb-8 select-none"
					>
						Projects
					</h2>

					<div class="space-y-12">
						{projects.map((project, i) => (
							<div class="relative pl-0 md:pl-8">
								<span
									aria-hidden="true"
									class="absolute left-0 top-0 text-neutral-300 text-xs hidden md:block font-mono select-none"
								>
									{String(i + 1).padStart(2, '0')}
								</span>
								<ProjectCard {...project} />
							</div>
						))}
					</div>
				</section>

				<section aria-labelledby="section-stack">
					<h2
						id="section-stack"
						class="text-neutral-400 text-xs uppercase tracking-wider mb-6 select-none"
					>
						Stack
					</h2>
					<div class="flex flex-wrap gap-3">
						{technologies.map(({ name, link }) => (
							<a
								href={link}
								target="_blank"
								class="px-2 py-1 text-xs text-neutral-600 bg-neutral-50 hover:bg-neutral-100 border border-neutral-200/60 hover:border-neutral-300 rounded-lg transition-all"
							>
								{name}
							</a>
						))}
					</div>
				</section>
		</div>
	</main>
	<Footer />
</Base>
