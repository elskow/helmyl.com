---
import Base from '@/layouts/Base.astro';
---

<Base title="404 - Helmy Luqmanulhakim" robots="noindex, follow">
	<main id="main-content" class="min-h-screen flex items-center justify-center bg-white selection:bg-neutral-100">
		<a
			href="/"
			class="group flex flex-col items-center cursor-pointer select-none transition-opacity duration-500 hover:opacity-80"
		>
			<svg
				width="240"
				height="240"
				viewBox="0 0 240 240"
				xmlns="http://www.w3.org/2000/svg"
				class="text-neutral-300 fill-current stroke-current group-hover:text-neutral-400 transition-colors duration-300"
			>
				<defs>
					<style>
						.compass-label {
							font-family: inherit;
							font-size: 14px;
							text-anchor: middle;
							dominant-baseline: middle;
							stroke: none;
						}
					</style>
				</defs>

				<text x="120" y="40" class="compass-label">N</text>
				<text x="120" y="200" class="compass-label">S</text>
				<text x="40" y="120" class="compass-label">W</text>
				<text x="200" y="120" class="compass-label">E</text>
				<line x1="120" y1="55" x2="120" y2="185" stroke-width="1"></line>

				<line x1="55" y1="120" x2="185" y2="120" stroke-width="1"></line>

				<circle cx="120" cy="120" r="3" stroke="none"></circle>
			</svg>

			<div class="mt-4 space-y-3 text-center">
				<p class="text-neutral-400 text-sm tracking-widest">Missing Out?</p>
			</div>
		</a>
	</main>
</Base>
