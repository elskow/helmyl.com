---
import Base from '@/layouts/Base.astro';
import Footer from '@/components/Footer.astro';
import Icon from '@/components/Icon.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import labsMetadata from '@/lib/generated/labs-metadata.json';

const projects = labsMetadata;
const latestEditedAt = projects[0]?.editedAt;

const parseLabDate = (value: string) => {
	const normalized = value.replace(
		/^(\d{4}-\d{2}-\d{2}) (\d{2}:\d{2}:\d{2}) ([+-]\d{2})(\d{2})$/,
		'$1T$2$3:$4'
	);
	const date = new Date(normalized);
	return Number.isFinite(date.getTime()) ? date : null;
};

const formatEditedAt = (value: string) => {
	const date = parseLabDate(value);
	if (!date) return 'Unknown';
	return new Intl.DateTimeFormat('en', {
		month: 'short',
		day: 'numeric',
		year: 'numeric'
	}).format(date);
};

const labMeta: Record<string, { categories: string[] }> = {
	blackhole: { categories: ['graphics', 'webgl', 'physics'] },
	gbemu: { categories: ['game', 'wasm', 'systems'] },
	'marble-run': { categories: ['graphics', 'webgl', 'physics'] },
	'rotating-donut': { categories: ['graphics', 'webgl', '3d'] },
	'space-shooter': { categories: ['game', 'canvas', 'arcade'] },
	'uiia-cat': { categories: ['graphics', '3d', 'model'] }
};

const getCategories = (slug: string) => labMeta[slug]?.categories || ['experiment'];

const graphNodes = projects.map((p, i) => {
	const total = projects.length;
	const angle = (i / (total || 1)) * Math.PI * 2 - Math.PI / 2;
	const r = 35;
	return {
		id: p.slug,
		name: p.name,
		x: 50 + r * Math.cos(angle),
		y: 50 + r * Math.sin(angle)
	};
});

const graphEdges = graphNodes.flatMap((n1, i) =>
	graphNodes
		.slice(i + 1)
		.filter((n2) => (labMeta[n1.id]?.categories || []).some((c) => (labMeta[n2.id]?.categories || []).includes(c)))
		.map((n2) => ({ source: n1, target: n2 }))
);
---

<Base title="Labs - Helmy Luqmanulhakim" description="Experiments, demos, and proof-of-concepts. WebGL simulations, emulators, and physics toys built for the browser." path="/labs">
	<main id="main-content"
		class="max-w-screen-xl mx-auto px-4 sm:px-6 py-10 md:py-24 min-h-screen text-neutral-900 font-sans"
	>
		<div class="grid grid-cols-1 md:grid-cols-12 gap-8 md:gap-12 lg:gap-24">
			<div class="md:col-span-7 lg:col-span-8">
				<header class="mb-12 md:mb-20">
					<Breadcrumbs items={[{ label: 'Home', url: '/' }, { label: 'Labs', url: '/labs' }]} />
					<h1 class="text-3xl sm:text-4xl font-medium tracking-tight text-neutral-950 mb-4">
						Labs
					</h1>
					<p class="text-lg text-neutral-500 max-w-md leading-relaxed font-light">
						Experiments, demos, and proof-of-concepts. Newest edits appear first.
					</p>
				</header>

				<ul class="space-y-0 border-t border-neutral-100 list-none p-0">
					{
						projects.map((project) => (
							<li class="group py-6 border-b border-neutral-100 flex flex-col sm:flex-row sm:items-baseline justify-between gap-4">
								<div class="flex-1">
									<a
										href={`/labs/${project.slug}`}
										class="block group/link rounded-sm outline-none focus-visible:ring-2 focus-visible:ring-neutral-200"
										data-lab-link={project.slug}
									>
										<div class="flex items-center gap-2 mb-2">
											<h2 class="text-base font-medium text-neutral-900 group-hover/link:underline decoration-neutral-300 underline-offset-4 transition-all">
												{project.name}
											</h2>
											<Icon
												name="arrow-up-right"
												class="w-3.5 h-3.5 text-neutral-300 group-hover/link:text-neutral-900 transition-colors"
											/>
											<span class="sr-only">(opens experiment page)</span>
										</div>
										<p class="text-sm text-neutral-500 max-w-md leading-relaxed mb-3">
											{project.description}
										</p>
										<div
											aria-hidden="true"
											class="flex flex-wrap gap-x-2 gap-y-1 text-[10px] uppercase tracking-wider font-mono text-neutral-400"
										>
											{getCategories(project.slug).map((cat) => (
												<span class="transition-colors group-hover/link:text-neutral-500">{cat}</span>
											))}
										</div>
									</a>
								</div>

								<div
									aria-hidden="true"
									class="shrink-0 flex items-center gap-4 text-xs font-mono text-neutral-400 mt-2 sm:mt-0"
								>
									<span>{formatEditedAt(project.editedAt)}</span>
									{project.version && <span>v{project.version}</span>}
								</div>
							</li>
						))
					}
				</ul>
			</div>

			<aside
				class="md:col-span-5 lg:col-span-4 md:pl-6 lg:pl-12 xl:pl-24 pt-8 md:pt-0 border-t border-neutral-100 md:border-t-0 mt-12 md:mt-0 min-w-0"
			>
				<div class="md:sticky md:top-24 space-y-8 md:space-y-12">
					<div aria-hidden="true" class="hidden md:block text-neutral-300">
						<Icon name="flask-conical" class="w-6 h-6" stroke-width={1.5} />
					</div>

					<div
						class="relative w-full aspect-square max-w-[160px] md:max-w-[180px] opacity-90 mx-auto md:mx-0"
					>
						<svg
							viewBox="0 0 100 100"
							class="w-full h-full overflow-visible"
							aria-hidden="true"
							id="lab-graph"
							role="presentation"
							focusable="false"
						>
							{
								graphEdges.map((edge) => (
									<line
										x1={edge.source.x}
										y1={edge.source.y}
										x2={edge.target.x}
										y2={edge.target.y}
										stroke="currentColor"
										stroke-width="0.5"
										class="transition-colors duration-500 text-neutral-100"
										data-graph-edge={`${edge.source.id} ${edge.target.id}`}
									/>
								))
							}

							{
								graphNodes.map((node) => (
									<g data-graph-node={node.id}>
										<circle
											cx={node.x}
											cy={node.y}
											r="1.5"
											fill="currentColor"
											class="transition-all duration-300 text-neutral-300"
										/>
										<text
											x={node.x}
											y={node.y - 6}
											text-anchor="middle"
											class="text-[5px] font-mono fill-neutral-600 transition-opacity opacity-0"
										>
											{node.name}
										</text>
									</g>
								))
							}
						</svg>
					</div>

					<div class="text-xs text-neutral-400 leading-relaxed space-y-2">
						<p>These projects are experimental.</p>
						<p>Sorted by latest edited time.</p>
						{
							latestEditedAt && <p>Latest edit: {formatEditedAt(latestEditedAt)}</p>
						}
					</div>
				</div>
			</aside>
		</div>
	</main>
	<Footer />
</Base>

<script>
	const links = document.querySelectorAll<HTMLElement>('[data-lab-link]');
	const nodes = document.querySelectorAll<SVGGraphicsElement>('[data-graph-node]');
	const edges = document.querySelectorAll<SVGGraphicsElement>('[data-graph-edge]');

	function setHover(slug: string | null) {
		for (const node of nodes) {
			const active = node.getAttribute('data-graph-node') === slug;
			const circle = node.querySelector('circle');
			const label = node.querySelector('text');
			if (!circle || !label) continue;
			circle.setAttribute('r', active ? '3' : '1.5');
			circle.classList.toggle('text-neutral-800', active);
			circle.classList.toggle('text-neutral-300', !active);
			label.classList.toggle('opacity-0', !active);
		}
		for (const edge of edges) {
			const [a, b] = (edge.getAttribute('data-graph-edge') || '').split(' ');
			const active = a === slug || b === slug;
			edge.setAttribute('stroke-width', active ? '0.75' : '0.5');
			edge.classList.toggle('text-neutral-400', active);
			edge.classList.toggle('text-neutral-100', !active);
		}
	}

	for (const link of links) {
		const slug = link.getAttribute('data-lab-link') || '';
		link.addEventListener('mouseenter', () => setHover(slug));
		link.addEventListener('mouseleave', () => setHover(null));
		link.addEventListener('focus', () => setHover(slug));
		link.addEventListener('blur', () => setHover(null));
	}
</script>
