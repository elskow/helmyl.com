---
import Base from '@/layouts/Base.astro';
import Footer from '@/components/Footer.astro';
import Icon from '@/components/Icon.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import { sortedProjects } from '@/data/projects';

const groupedProjects = sortedProjects.reduce(
	(acc, project) => {
		const year = new Date(project.date).getFullYear();
		if (!acc[year]) acc[year] = [];
		acc[year].push(project);
		return acc;
	},
	{} as Record<number, typeof sortedProjects>
);

const sortedYears = Object.entries(groupedProjects).sort(([a], [b]) => Number(b) - Number(a));

const breadcrumbs = [
	{ label: 'Home', url: '/' },
	{ label: 'Projects', url: '/projects' }
];
---

<Base
	title="Projects - Helmy Luqmanulhakim"
	description="Selected works, open source contributions, and tools."
	path="/projects"
	ogImage="/og/projects.png"
>
	<main id="main-content"
		class="max-w-screen-xl mx-auto px-4 sm:px-6 py-10 md:py-24 min-h-screen text-neutral-900 font-sans"
	>
		<div class="grid grid-cols-1 md:grid-cols-12 gap-8 md:gap-12 lg:gap-24">
			<div class="md:col-span-7 lg:col-span-8">
				<header class="mb-20 md:mb-32">
					<Breadcrumbs items={breadcrumbs} />

					<h1 class="text-3xl sm:text-4xl font-medium tracking-tight text-neutral-950 mb-4">
						Projects
					</h1>
					<p class="text-lg text-neutral-500 max-w-md leading-relaxed font-light">
						Selected works, and developer tools.
					</p>
				</header>

				<div class="space-y-24">
					{
						sortedYears.map(([year, yearProjects]) => (
							<section class="relative" aria-labelledby={`year-${year}`}>
								<div class="md:absolute md:-left-32 md:top-0 mb-6 md:mb-0">
									<h2
										id={`year-${year}`}
										class="font-mono text-xs text-neutral-400 select-none"
										aria-hidden="true"
									>
										{year}
									</h2>
								</div>

								<div class="border-l border-neutral-100 pl-8 md:pl-10 space-y-16">
									{yearProjects.map((project) => (
										<article class="group relative">
											<div class="absolute -left-[37px] md:-left-[45px] top-2.5 w-1.5 h-1.5 rounded-full bg-neutral-200 ring-4 ring-white group-hover:bg-neutral-400 transition-colors duration-300" />

											<a
												href={project.github}
												class="block"
												target="_blank"
												rel="noopener noreferrer"
												aria-label={`${project.name}: ${project.description}. Opens on GitHub in a new tab`}
											>
												<div class="flex items-start justify-between gap-4 mb-3">
													<h3 class="text-base font-medium text-neutral-900 group-hover:underline decoration-neutral-300 underline-offset-4 transition-all">
														{project.name}
													</h3>

													<div
														aria-hidden="true"
														class="shrink-0 text-neutral-300 group-hover:text-neutral-900 transition-colors"
													>
														<Icon name="arrow-up-right" class="w-3.5 h-3.5" />
													</div>
												</div>

												<p class="text-sm text-neutral-500 leading-relaxed mb-5 max-w-lg">
													{project.description}
												</p>

												<div
													aria-hidden="true"
													class="flex flex-wrap gap-2"
												>
													{project.stacks.slice(0, 5).map((stack) => (
														<span class="text-[10px] px-2 py-1 bg-neutral-50 text-neutral-500 rounded-sm border border-neutral-100 font-medium tracking-wide">
															{stack}
														</span>
													))}
												</div>
											</a>
										</article>
									))}
								</div>
							</section>
						))
					}
				</div>
			</div>

			<aside
				class="md:col-span-5 lg:col-span-4 md:pl-6 lg:pl-12 xl:pl-24 space-y-8 md:space-y-16 pt-8 md:pt-0 border-t border-neutral-100 md:border-t-0 mt-12 md:mt-0 min-w-0"
			>
				<div class="md:sticky md:top-24 space-y-8 md:space-y-16">
					<div aria-hidden="true" class="hidden md:block text-neutral-300">
						<Icon name="layout-panel-left" class="w-6 h-6" stroke-width={1.5} />
					</div>

					<div>
						<p class="text-[10px] text-neutral-400 mb-4 uppercase tracking-widest select-none">
							Focus
						</p>
						<ul
							aria-label="Project focus areas"
							class="flex flex-wrap gap-x-6 gap-y-2 md:block md:space-y-2 text-sm text-neutral-500 list-none p-0"
						>
							<li>Infrastructure</li>
							<li>Web Development</li>
							<li>Data Engineering</li>
							<li>Developer Tools</li>
						</ul>
					</div>
				</div>
			</aside>
		</div>
	</main>
	<Footer />
</Base>
