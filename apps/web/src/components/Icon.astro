---
import lucide from '@iconify-json/lucide/icons.json';
import simpleIcons from '@iconify-json/simple-icons/icons.json';
import { getIconData, iconToSVG, replaceIDs } from '@iconify/utils';

interface Props {
	name: string;
	class?: string;
	'stroke-width'?: number;
}

const { name, class: className = 'w-4 h-4', 'stroke-width': strokeWidth = 2 } = Astro.props;

const aliases: Record<string, string> = { java: 'openjdk' };
const resolved = aliases[name] ?? name;
const data =
	getIconData(lucide as never, resolved) ??
	getIconData(simpleIcons as never, resolved);

if (!data) throw new Error(`Icon "${name}" not found in lucide or simple-icons sets`);

const { attributes, body } = iconToSVG(
	{ ...data, left: 0, top: 0, width: data.width ?? 24, height: data.height ?? 24 },
	{ height: '1em' }
);
const vb = `0 0 ${data.width ?? 24} ${data.height ?? 24}`;
const markup = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="${vb}" fill="none" class="${className}" stroke="currentColor" stroke-width="${strokeWidth}" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${body}</svg>`;
---

<Fragment set:html={replaceIDs(markup)} />
