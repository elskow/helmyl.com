---
import Icon from './Icon.astro';
import type { Breadcrumb } from '../layouts/Base.astro';

interface Props {
	items: Breadcrumb[];
}

const { items } = Astro.props;

const jsonLd = {
	'@type': 'BreadcrumbList',
	itemListElement: items.map((item, i) => ({
		'@type': 'ListItem',
		position: i + 1,
		name: item.label,
		item: `https://helmyl.com${item.url}`
	}))
};
---

<script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', '@graph': [jsonLd] }) } />

<nav aria-label="Breadcrumb" class="mb-8">
	<ol class="flex items-center gap-1 text-xs text-neutral-400">
		{
			items.map((item, i) => (
				<li class="flex items-center gap-1">
					{i > 0 && <Icon name="chevron-right" class="w-3 h-3 text-neutral-300" />}
					{i < items.length - 1 ? (
						<a href={item.url} class="hover:text-neutral-900 transition-colors">
							{item.label}
						</a>
					) : (
						<span aria-current="page" class="text-neutral-400 select-none">
							{item.label}
						</span>
					)}
				</li>
			))
		}
	</ol>
</nav>
