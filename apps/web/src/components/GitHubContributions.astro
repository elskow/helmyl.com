---
import Icon from '@/components/Icon.astro';
import { env as cfEnv } from 'cloudflare:workers';

interface Props {
	username?: string;
}

const { username = 'elskow' } = Astro.props;
const token = cfEnv?.GITHUB_API_TOKEN;

interface Day {
	date: string;
	count: number;
	level: 0 | 1 | 2 | 3 | 4;
	weekday: number;
}

interface Week {
	days: Day[];
}

interface Calendar {
	total: number;
	weeks: Week[];
	fetchedAt: string;
}

const LEVEL_FILL = ['#e5e5e5', '#c9c9c9', '#a3a3a3', '#6b6b6b', '#262626'];

const CELL = 11;
const GAP = 3;
const STEP = CELL + GAP;
const TOP = 18;

const MONTHS = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
const DAY_LABELS: Record<number, string> = { 1: 'Mon', 3: 'Wed', 5: 'Fri' };

const fetchCalendar = async (): Promise<Calendar | null> => {
	if (!token) return null;
	const query = `query($user: String!) {
			user(login: $user) {
				contributionsCollection {
					contributionCalendar {
						totalContributions
						weeks {
							contributionDays {
								date
								contributionCount
								contributionLevel
							}
						}
					}
				}
			}
		}`;
	try {
		const res = await fetch('https://api.github.com/graphql', {
			method: 'POST',
			headers: {
				'Content-Type': 'application/json',
				Authorization: `bearer ${token}`,
				'User-Agent': 'helmyl.com'
			},
			body: JSON.stringify({ query, variables: { user: username } })
		});
		if (!res.ok) {
			console.error(`[GitHubContributions] GitHub API ${res.status}: ${await res.text().catch(() => '')}`);
			return null;
		}
		const json = await res.json();
		const cal = json.data?.user?.contributionsCollection?.contributionCalendar;
		if (!cal) {
			console.error('[GitHubContributions] No calendar in response:', JSON.stringify(json).slice(0, 200));
			return null;
		}

		const weeks: Week[] = cal.weeks.map(
			(w: { contributionDays: Record<string, unknown>[] }) => ({
				days: w.contributionDays
					.filter((d) => d.date)
					.map((d) => ({
						date: String(d.date),
						count: Number(d.contributionCount),
						level:
							(
								{
									NONE: 0,
									FIRST_QUARTILE: 1,
									SECOND_QUARTILE: 2,
									THIRD_QUARTILE: 3,
									FOURTH_QUARTILE: 4
								} as const
							)[String(d.contributionLevel)] ?? 0,
						weekday: new Date(String(d.date) + 'T00:00:00Z').getUTCDay()
					}))
			})
		);

		return {
			total: Number(cal.totalContributions),
			weeks,
			fetchedAt: new Date().toISOString()
		};
	} catch {
		return null;
	}
};

const calendar = await fetchCalendar();

if (calendar) {
	Astro.response.headers.set('Cache-Control', 'public, max-age=3600, s-maxage=3600');
} else {
	Astro.response.headers.set('Cache-Control', 'no-store');
}

let cellRects: { x: number; y: number; fill: string; date: string; count: number }[] = [];
let monthLabels: { x: number; text: string }[] = [];
let gridWidth = 0;

if (calendar) {
	const weekCount = calendar.weeks.length;
	gridWidth = weekCount * STEP;

	calendar.weeks.forEach((week, wi) => {
		week.days.forEach((day) => {
			cellRects.push({
				x: wi * STEP,
				y: TOP + day.weekday * STEP,
				fill: LEVEL_FILL[day.level],
				date: day.date,
				count: day.count
			});
		});
		const firstDay = week.days[0];
		if (firstDay) {
			const d = new Date(firstDay.date + 'T00:00:00Z');
			if (
				d.getUTCDate() <= 7 &&
				d.getUTCMonth() !==
					new Date(week.days[week.days.length - 1].date + 'T00:00:00Z').getUTCMonth()
			) {
				monthLabels.push({ x: wi * STEP, text: MONTHS[d.getUTCMonth()] });
			}
		}
	});
}

const gridHeight = TOP + 7 * STEP;

const emptyCellRects: { x: number; y: number; fill: string }[] = [];
for (let wi = 0; wi < 53; wi++) {
	for (let wd = 0; wd < 7; wd++) {
		emptyCellRects.push({
			x: wi * STEP,
			y: TOP + wd * STEP,
			fill: LEVEL_FILL[0]
		});
	}
}
---

<div class="contribution-card">
	{calendar ? (
		<>
			<div class="flex items-baseline justify-between mb-3">
				<p class="text-xs text-neutral-500">
					<span class="text-neutral-900 font-medium tabular-nums">
						{calendar.total.toLocaleString('en-US')}
					</span>{' '}
					contributions in the last year
				</p>
				<a
					href={`https://github.com/${username}`}
					target="_blank"
					class="text-xs text-neutral-400 hover:text-neutral-900 transition-colors flex items-center gap-1"
				>
					@{username} <Icon name="arrow-up-right" class="w-3 h-3" />
				</a>
			</div>
			<div class="overflow-x-auto pb-3 pt-1 -mb-1 thin-scrollbar">
				<svg
					width={gridWidth + 34}
					height={gridHeight}
					viewBox={`0 0 ${gridWidth + 34} ${gridHeight}`}
					class="graph-svg block select-none"
					aria-label={`GitHub contribution graph for ${username}`}
					role="img"
				>
					{DAY_LABELS ? (
						<g>
							{[1, 3, 5].map((wd) => (
								<text x={0} y={TOP + wd * STEP + CELL - 2} class="contrib-label">
									{DAY_LABELS[wd]}
								</text>
							))}
						</g>
					) : null}
					{monthLabels.map((m) => (
						<text x={m.x + 34} y={12} class="contrib-label">
							{m.text}
						</text>
					))}
					<g transform="translate(34, 0)">
						{cellRects.map((c) => (
							<rect x={c.x} y={c.y} width={CELL} height={CELL} rx={2.5} fill={c.fill}>
								<title>{`${c.count} contribution${c.count === 1 ? '' : 's'} on ${c.date}`}</title>
							</rect>
						))}
					</g>
				</svg>
			</div>
		</>
	) : (
		<div class="overflow-x-auto pb-3 pt-1 -mb-1 thin-scrollbar" title="Contribution graph couldn't be loaded — GitHub API unreachable right now.">
			<svg
				width={53 * STEP + 34}
				height={gridHeight}
				viewBox={`0 0 ${53 * STEP + 34} ${gridHeight}`}
				class="graph-svg block select-none"
				aria-label="GitHub contribution graph (currently unavailable)"
				role="img"
			>
				<g>
					{[1, 3, 5].map((wd) => (
						<text x={0} y={TOP + wd * STEP + CELL - 2} class="contrib-label">
							{DAY_LABELS[wd]}
						</text>
					))}
				</g>
				<g transform="translate(34, 0)" opacity="0.55">
					{emptyCellRects.map((c) => (
						<rect x={c.x} y={c.y} width={CELL} height={CELL} rx={2.5} fill={c.fill}></rect>
					))}
				</g>
			</svg>
		</div>
	)}
</div>

<style>
	.contrib-label {
		font-size: 9px;
		fill: #a3a3a3;
	}
	.graph-svg {
		width: 100%;
		height: auto;
		min-width: 540px;
	}
	.contribution-card :global(code) {
		font-family: inherit;
	}
</style>
